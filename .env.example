# Domain configuration
DOMAIN=localhost

# Subdomains configuration
# Customize the subdomains for your services
SUBDOMAIN_TRAEFIK=pr
SUBDOMAIN_PORTAINER=painel
SUBDOMAIN_N8N=n8n
SUBDOMAIN_REMOTION=remotion
SUBDOMAIN_MINIO=minio
SUBDOMAIN_S3=s3

# Timezone
TZ=America/Sao_Paulo

# Traefik Dashboard Authentication
# Default password: admin
# Generate new hash with: echo $(htpasswd -nb admin your_password) | sed -e s/\\$/\\$\\$/g
TRAEFIK_USER=admin:$$apr1$$8EVjn/nj$$GiLUZqcbueTFeD23SuB6x0

# ACME (Let's Encrypt) - HTTP challenge
# Email para notificações de renovação de certificados. Porta 80 deve estar acessível.
ACME_EMAIL=your-email@example.com

# Docker Swarm Configuration (opcional)
# Usado pelos scripts swarm-init.sh e swarm-deploy.sh
STACK_NAME=traefik
# Se o SSH herdar DOCKER_CONTEXT remoto: export SWARM_DEPLOY_FORCE_LOCAL=1 antes de ./swarm-deploy.sh
# para forcar socket local sem prompt interativo.
# SWARM_DEPLOY_FORCE_LOCAL=1

# ================================================================================
# n8n Configuration (Automação de Workflows)
# ================================================================================
# Subdomínio: definido em SUBDOMAIN_N8N (ex.: n8n → https://n8n.${DOMAIN})

# Protocolo do n8n (https para produção, http para desenvolvimento)
N8N_PROTOCOL=https

# Chave de criptografia para credenciais armazenadas no n8n
# Gere uma chave aleatória: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change_this_to_a_random_32char_string

# URL dos webhooks e proxy (a stack usa SUBDOMAIN_N8N + DOMAIN automaticamente)
# Opcional: override manual (ex.: WEBHOOK_URL=https://n8n.seudominio.com/)
# WEBHOOK_URL=https://${SUBDOMAIN_N8N}.${DOMAIN}/
# N8N_PROXY_HOPS=1

# PostgreSQL do n8n (stack docker-stack-n8n.yml usa Postgres)
# Gere uma senha: openssl rand -base64 24
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=change_this_secure_password

# ================================================================================
# WordPress Configuration
# ================================================================================

# WordPress Database Configuration
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=change_this_secure_password
WORDPRESS_DB_ROOT_PASSWORD=change_this_root_password

# WordPress Table Prefix (default: wp_)
WORDPRESS_TABLE_PREFIX=wp_

# Backup Configuration
# Cron format: minute hour day month weekday
# Default: 0 2 * * * (2 AM every day)
BACKUP_SCHEDULE=0 2 * * *

# ================================================================================
# Remotion (Studio + Render worker) + MinIO (S3 storage)
# ================================================================================
# Subdominios: Studio (SUBDOMAIN_REMOTION), MinIO Console (SUBDOMAIN_MINIO)
# e API S3 (SUBDOMAIN_S3) ja estao configurados na secao de subdominios acima.
#
# BasicAuth do Remotion Studio (independente do TRAEFIK_USER do dashboard).
# Gere com: htpasswd -nb usuario senha | sed 's/\\$/\\$\\$/g'
# swarm-deploy.sh preenche admin/admin123 se estiver vazio.
# REMOTION_BASIC_AUTH=admin:$$apr1$$...

# MinIO (S3 compativel) - credenciais root do storage
# Padrao usado pelo script se vazio ou placeholder: admin / admin123
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change_this_strong_minio_password

# Bucket criado automaticamente pelo servico minio-setup
REMOTION_S3_BUCKET=remotion

