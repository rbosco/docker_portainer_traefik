        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "kie-status",
      "name": "kie.ai – Status vídeo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURAR_KIE_AI",
          "name": "kie.ai API Key"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-success",
              "leftValue": "={{ $json.data?.status || $json.status }}",
              "rightValue": "success",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-success",
      "name": "Status success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1780, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://fal.ai/models/fal-ai/sync-lipsync/run",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"video_url\": {{ JSON.stringify($json.data?.video_url || $json.video_url) }},\n  \"audio_url\": \"\"\n}",
        "options": {}
      },
      "id": "lipsync",
      "name": "Lip sync (fal.ai)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 120],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURAR_FAL_AI",
          "name": "fal.ai API Key"
        }
      },
      "notesInFlow": true,
      "notes": "Configurar URL/body conforme API escolhida (fal.ai, Lipsync.studio ou Lipdub)"
    },
    {
      "parameters": {
        "jsCode": "// Saída do loop: um item com video_url (do lip sync ou do kie.ai) para o agrupador\nconst item = $input.first();\nconst j = item.json?.data || item.json || {};\nreturn [{ json: { video_url: j.video_url || j.output?.video_url } }];"
      },
      "id": "code-pass",
      "name": "Guardar ref cena",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2220, 120]
    },
    {
      "parameters": {
        "jsCode": "// Loop terminou: recebe um item por cena (com video_url). Ordem = ordem de chegada.\nconst items = $input.all();\nconst videoUrls = items.map(i => i.json.video_url).filter(Boolean);\nconst nomeProjeto = $getWorkflowStaticData('global').nomeProjeto || 'vsl';\nreturn [{ json: { videoUrls, nomeProjeto } }];"
      },
      "id": "code-concat-list",
      "name": "Listar videos para concat",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 400]
    },
    {
      "parameters": {
        "command": "=echo 'Concatenação: configure ffmpeg ou API externa. URLs=' && echo {{ JSON.stringify($json.videoUrls) }}"
      },
      "id": "exec-concat",
      "name": "Concatenacao ffmpeg API",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1340, 400],
      "notesInFlow": true,
      "notes": "Substituir por: 1) Execute Command com ffmpeg -f concat, ou 2) HTTP Request para API de concatenação. Entrada: $json.videoUrls e $json.nomeProjeto."
    },
