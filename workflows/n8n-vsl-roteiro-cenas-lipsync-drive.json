      "id": "drive-download",
      "name": "Ler arquivo roteiro",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [460, 300],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "CONFIGURAR_GOOGLE_DRIVE",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Converte binário do Drive em texto e faz parse do roteiro JSON.\n// Formato esperado: { nomeProjeto, aspectRatio, quality, cenas: [{ prompt, texto?, duracao, ordem }] }\nconst item = $input.first();\nconst binary = item.binary?.data;\nif (!binary) throw new Error('Nenhum arquivo binário no item');\nconst data = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst text = data.toString('utf8');\nlet roteiro;\ntry {\n  roteiro = JSON.parse(text);\n} catch (e) {\n  throw new Error('Roteiro inválido: deve ser JSON com nomeProjeto, aspectRatio, quality, cenas[]');\n}\nconst cenas = roteiro.cenas || [];\nconst global = {\n  nomeProjeto: roteiro.nomeProjeto || 'vsl',\n  aspectRatio: roteiro.aspectRatio || '9:16',\n  quality: roteiro.quality || '720p'\n};\nconst staticData = $getWorkflowStaticData('global');\nstaticData.nomeProjeto = global.nomeProjeto;\nreturn cenas.map((c, i) => ({ json: { ...c, ordem: c.ordem ?? i, ...global } }));"
      },
      "id": "code-parse",
      "name": "Parse roteiro em cenas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "loop-cenas",
      "name": "Loop por cena",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [900, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.kie.ai/api/v1/runway/generate",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"prompt\": {{ JSON.stringify($json.prompt) }},\n  \"duration\": {{ $json.duracao || 5 }},\n  \"quality\": {{ JSON.stringify($json.quality || '720p') }},\n  \"aspectRatio\": {{ JSON.stringify($json.aspectRatio || '9:16') }},\n  \"waterMark\": \"\",\n  \"callBackUrl\": \"\"\n}",
        "options": {}
      },
      "id": "kie-generate",
      "name": "kie.ai – Gerar vídeo cena",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURAR_KIE_AI",
          "name": "kie.ai API Key"
        }
      },
      "notesInFlow": true,
      "notes": "Header: Authorization = Bearer SEU_API_KEY"
    },
    {
      "parameters": {
        "amount": 30,
        "unit": "seconds"
      },
      "id": "wait-poll",
      "name": "Aguardar geração",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1340, 200]
    },
    {
      "parameters": {
        "method": "GET",
